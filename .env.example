# ==============================================================================
# Cloud SQL PostgreSQL Configuration
# ==============================================================================
# When connecting to Google Cloud SQL via Cloud SQL Auth Proxy or Direct IP:
SQL_HOST="127.0.0.1"
SQL_PORT=5432
SQL_USER="postgres"
SQL_PASSWORD="postgres_password"
SQL_DB_NAME="b2b_subscription_db"

# Admin credentials for running DDL / Drizzle migrations
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="postgres_password"

# Optional Cloud SQL instance connection name (format: project-id:region:instance-name)
# e.g., b2b-sub-mgmt-api:us-central1:b2b-postgres-instance
CLOUD_SQL_CONNECTION_NAME="b2b-sub-mgmt-api:us-central1:b2b-postgres-instance"

# ==============================================================================
# Firebase & Firestore Configuration
# ==============================================================================
FIREBASE_PROJECT_ID="b2b-sub-mgmt-api"
# For local emulator testing:
# FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"
# FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"

# ==============================================================================
# Application Server & Gemini AI
# ==============================================================================
PORT=3000
NODE_ENV="development"
GEMINI_API_KEY=""
APP_URL="http://localhost:3000"
